
{
  "name": "my-creations",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev:web": "pnpm --filter @my-creations/web dev",
    "dev:api": "pnpm --filter @my-creations/api start:dev",
    "build:web": "pnpm --filter @my-creations/web build",
    "build:api": "pnpm --filter @my-creations/api build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
